{
  "name": "nimbus-erp-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "temas": "node scripts/copiar-temas.mjs",
    "predev": "npm run temas",
    "dev": "vite",
    "prebuild": "npm run temas",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "oxlint --max-warnings=0",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "axios": "^1.20.0",
    "primeicons": "^7.0.0",
    "primereact": "^10.9.9",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.4.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.1.0",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "description": "Frontend do Nimbus ERP (React + TypeScript + PrimeReact)."
}
